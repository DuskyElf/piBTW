#!/usr/bin/env bash
# Update pi extensions in dotfiles
# Extensions live in libs/ as submodules and are symlinked to agent/extensions/
# WARNING: git reset --hard will OVERWRITE any local changes to the extension!
# Back up custom modifications before running.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
DOTFILES_DIR="$(dirname "$SCRIPT_DIR")"
LIBS_DIR="$DOTFILES_DIR/libs"

SUCCESS=()
FAILED=()

# Discover all extensions from libs/ (implicit registry)
# Each subdirectory in libs/ is treated as an extension
EXTENSIONS=()
for ext_dir in "$LIBS_DIR"/*/; do
  [ -d "$ext_dir" ] || continue
  ext=$(basename "$ext_dir")
  
  # Skip if it's a symlink (shouldn't happen, but safety check)
  if [ -L "$ext_dir" ]; then
    echo "Skipping $ext (is a symlink, skipping)"
    continue
  fi
  
  # Check if it's a git repository (could be a file < 100 bytes = submodule marker, or directory)
  if [ ! -e "$ext_dir/.git" ]; then
    echo "Warning: $ext is not a git repository, skipping (use git submodule add)"
    continue
  fi
  
  EXTENSIONS+=("$ext")
done

# Sort for consistent ordering
IFS=$'\n' EXTENSIONS=($(sort <<< "${EXTENSIONS[*]}"))
IFS=$'\n'

echo "Discovered ${#EXTENSIONS[@]} extensions: ${EXTENSIONS[*]}"
echo ""

for ext in "${EXTENSIONS[@]}"; do
  ext_path="$LIBS_DIR/$ext"

  if [ ! -d "$ext_path" ]; then
    echo "Skipping $ext (not found at $ext_path)"
    continue
  fi

  echo "Updating $ext..."
  cd "$ext_path"

  # Determine which remote branch exists
  BRANCH=""
  if git ls-remote --exit-code origin main >/dev/null 2>&1; then
    BRANCH="main"
  elif git ls-remote --exit-code origin master >/dev/null 2>&1; then
    BRANCH="master"
  else
    echo "ERROR: No origin/main or origin/master found for $ext" >&2
    FAILED+=("$ext")
    continue
  fi

  # Fetch and reset with explicit error checking
  if ! git fetch origin "$BRANCH"; then
    echo "ERROR: git fetch failed for $ext" >&2
    FAILED+=("$ext")
    continue
  fi

  if ! git reset --hard "origin/$BRANCH"; then
    echo "ERROR: git reset failed for $ext" >&2
    FAILED+=("$ext")
    continue
  fi

  # Reinstall dependencies (git reset --hard removes node_modules)
  if [ -f package.json ]; then
    echo "Installing dependencies for $ext..."
    if ! npm install; then
      echo "ERROR: npm install failed for $ext" >&2
      FAILED+=("$ext")
      continue
    fi
  fi

  echo "Updated $ext"
  SUCCESS+=("$ext")
done

echo ""
echo "=== Summary ==="
echo "Succeeded: ${SUCCESS[*]:-none}"
echo "Failed: ${FAILED[*]:-none}"

if [ ${#FAILED[@]} -gt 0 ]; then
  echo "Some extensions failed - check errors above"
  exit 1
fi

echo ""
echo "Done! Restart pi to load the new version."